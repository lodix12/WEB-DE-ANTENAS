{
  "id": "./",
  "name": "Redes Moviles España · Antenas Móviles",
  "short_name": "Redes Moviles España",
  "description": "Mapa interactivo, bandas de frecuencia y censo oficial de antenas de redes móviles en España actualizado a diario.",
